@model IEnumerable<SistemaAdopcionMascotas.Models.Pet>

<h1>Lista de Mascotas</h1>

<p>
    <a asp-action="Create">Registrar nueva mascota</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Edad</th>
            <th>Tipo</th>
            <th>Adoptada</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Nombre</td>
            <td>@item.Edad</td>
            <td>@item.Tipo</td>
            <td>@(item.Adoptada ? "Sí" : "No")</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Ver</a> |
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
